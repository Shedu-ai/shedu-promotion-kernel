{
  "schemaVersion": "policy-pack@1",
  "packId": "validation-plan",
  "version": "1.1.0",
  "description": "Kernel integrity pack: executes every contract validation command exactly once, in its declared phase, through the sandboxed exact-argv runner, captures machine reports, and proves per-phase completeness.",
  "phases": ["CONTRACT_ADMISSION", "CANDIDATE_VALIDATION", "PROMOTION_FINALIZATION"],
  "dependencies": [],
  "checks": [
    {
      "checkId": "validation-plan-admission",
      "phase": "CONTRACT_ADMISSION",
      "effect": "BLOCKING",
      "validator": { "kind": "BUILTIN", "builtinId": "validation-plan-execute@1" },
      "inputs": ["validation-commands", "candidate-workspace"],
      "outputSchemaId": "check-result@1",
      "timeoutSeconds": 3600,
      "network": "NONE",
      "filesystem": "READ_ONLY",
      "envAllowlist": [],
      "resultConsumer": "DISPOSITION_REDUCER"
    },
    {
      "checkId": "validation-plan-validation",
      "phase": "CANDIDATE_VALIDATION",
      "effect": "BLOCKING",
      "validator": { "kind": "BUILTIN", "builtinId": "validation-plan-execute@1" },
      "inputs": ["validation-commands", "candidate-workspace"],
      "outputSchemaId": "check-result@1",
      "timeoutSeconds": 3600,
      "network": "NONE",
      "filesystem": "READ_ONLY",
      "envAllowlist": [],
      "resultConsumer": "DISPOSITION_REDUCER"
    },
    {
      "checkId": "validation-plan-finalization",
      "phase": "PROMOTION_FINALIZATION",
      "effect": "BLOCKING",
      "validator": { "kind": "BUILTIN", "builtinId": "validation-plan-execute@1" },
      "inputs": ["validation-commands", "candidate-workspace"],
      "outputSchemaId": "check-result@1",
      "timeoutSeconds": 3600,
      "network": "NONE",
      "filesystem": "READ_ONLY",
      "envAllowlist": [],
      "resultConsumer": "DISPOSITION_REDUCER"
    }
  ]
}
