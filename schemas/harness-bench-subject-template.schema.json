{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/harness-bench-subject-template.schema.json",
  "title": "Harness Bench Subject Template v2",
  "description": "A subject repository's self-declared, non-authoritative connection template. Version 2 adds exact read-only agent status and evidence inspection entrypoints. Harness Bench independently resolves and freezes the final subject identity before planning a run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subjectId",
    "repository",
    "subjectKind",
    "probeArgv",
    "promotionArgv",
    "statusArgv",
    "statusParameterMap",
    "evidenceInspectionArgv",
    "evidenceInspectionParameterMap",
    "capabilities",
    "implementationStatus",
    "commitShaSource"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "harness-bench-subject-template@2"
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
    },
    "subjectKind": {
      "type": "string",
      "enum": ["governed-harness", "promotion-kernel", "agent-harness"]
    },
    "probeArgv": {
      "$ref": "#/$defs/argv"
    },
    "promotionArgv": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/argv"}
      ]
    },
    "statusArgv": {
      "description": "Exact read-only argv for subject status; append the declared optional outputDir parameter to project a published evaluation.",
      "$ref": "#/$defs/argv"
    },
    "statusParameterMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputDir"],
      "properties": {
        "outputDir": {
          "const": {"flag": "--out", "kind": "path", "required": false}
        }
      }
    },
    "evidenceInspectionArgv": {
      "description": "Exact read-only argv for digest-bound evidence selection.",
      "$ref": "#/$defs/argv"
    },
    "evidenceInspectionParameterMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputDir", "artifactId", "maxBytes"],
      "properties": {
        "outputDir": {
          "const": {"flag": "--out", "kind": "path", "required": true}
        },
        "artifactId": {
          "const": {"flag": "--artifact", "kind": "kebab", "required": true}
        },
        "maxBytes": {
          "const": {"flag": "--max-bytes", "kind": "positiveInteger", "required": false}
        }
      }
    },
    "conformanceArgv": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/argv"}
      ]
    },
    "admittedPromotionArgv": {
      "description": "The exact promotion argv Harness Bench uses AFTER supplying external admission evidence (attestation, pinned key, expected commit). It does not weaken the default FOUNDATION_ONLY state: promotionArgv stays null until admission passes.",
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/argv"}
      ]
    },
    "promotionParameterMap": {
      "description": "Machine-readable mapping from logical run parameters to the CLI flags Harness Bench appends to admittedPromotionArgv. A harness constructs the full invocation deterministically from this map — no flags are hardcoded on the harness side. Parameters marked admissionMaterial carry the external admission evidence; without them the subject stays FOUNDATION_ONLY.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "repository", "outputDir"],
      "properties": {
        "contract": {"$ref": "#/$defs/parameter"},
        "repository": {"$ref": "#/$defs/parameter"},
        "outputDir": {"$ref": "#/$defs/parameter"},
        "attestation": {"$ref": "#/$defs/parameter"},
        "pinnedKey": {"$ref": "#/$defs/parameter"},
        "expectedCommit": {"$ref": "#/$defs/parameter"},
        "signKey": {"$ref": "#/$defs/parameter"},
        "projection": {"$ref": "#/$defs/parameter"}
      }
    },
    "publishedReceiptPath": {
      "description": "Where, relative to the promotion output directory, the atomically-published receipt appears on success. Harness Bench reads the receipt from here.",
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$"
      }
    },
    "implementationStatus": {
      "type": "string",
      "enum": ["FOUNDATION_ONLY", "EXPERIMENTAL", "PILOT_ELIGIBLE", "CERTIFIED"]
    },
    "commitShaSource": {
      "const": "RESOLVE_AND_FREEZE_BEFORE_PLAN"
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flag", "kind", "required"],
      "properties": {
        "flag": {"type": "string", "pattern": "^--[a-z][a-z-]*$"},
        "kind": {"type": "string", "enum": ["path", "hex64", "sha40", "kebab", "positiveInteger", "projection"]},
        "required": {"type": "boolean"},
        "admissionMaterial": {"type": "boolean"}
      }
    }
  }
}
