{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/capability-index.schema.json",
  "title": "capability-index@1",
  "description": "Target-owned prior-art index bound to the trusted base commit. Distinguishes declared intent (entries) from mechanically generated surface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "entries", "generatedSurface"],
  "properties": {
    "schemaVersion": {"const": "capability-index@1"},
    "repositoryId": {"$ref": "#/$defs/kebabId"},
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "owner",
          "title",
          "status",
          "canonicalFiles",
          "doNotRebuild",
          "allowedFollowUps",
          "receiptRefs"
        ],
        "properties": {
          "capabilityId": {"$ref": "#/$defs/versionedId"},
          "owner": {"type": "string", "minLength": 1, "maxLength": 256},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "status": {"enum": ["ACTIVE", "DEPRECATED"]},
          "canonicalFiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/relativePath"}
          },
          "doNotRebuild": {"type": "boolean"},
          "allowedFollowUps": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/kebabId"}
          },
          "receiptRefs": {
            "type": "array",
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        }
      }
    },
    "generatedSurface": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    }
  },
  "$defs": {
    "kebabId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 128},
    "versionedId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]*$", "maxLength": 128},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._/-]+$"}
  }
}
