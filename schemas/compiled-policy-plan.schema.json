{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/compiled-policy-plan.schema.json",
  "title": "compiled-policy-plan@1",
  "description": "Canonical, deterministic plan resolved from a work contract and profile. Equal inputs produce byte-identical plan bytes. The runtime executes only this plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kernelRelease",
    "repositoryId",
    "baseCommit",
    "candidate",
    "profileId",
    "sourceDigests",
    "checks"
  ],
  "properties": {
    "schemaVersion": {"const": "compiled-policy-plan@1"},
    "kernelRelease": {"type": "string", "minLength": 1, "maxLength": 128},
    "repositoryId": {"$ref": "#/$defs/kebabId"},
    "baseCommit": {"$ref": "#/$defs/commitId"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["COMMIT", "TREE"]},
        "id": {"$ref": "#/$defs/commitId"}
      }
    },
    "profileId": {"$ref": "#/$defs/kebabId"},
    "sourceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workContract", "profile", "capabilityIndex", "packs"],
      "properties": {
        "workContract": {"$ref": "#/$defs/digest"},
        "profile": {"$ref": "#/$defs/digest"},
        "capabilityIndex": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "packs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packId", "version", "digest"],
            "properties": {
              "packId": {"$ref": "#/$defs/kebabId"},
              "version": {"$ref": "#/$defs/semver"},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/planCheck"}
    }
  },
  "$defs": {
    "kebabId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 128},
    "versionedId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]*$", "maxLength": 128},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "commitId": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "phase": {"enum": ["CONTRACT_ADMISSION", "CANDIDATE_VALIDATION", "PROMOTION_FINALIZATION"]},
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "planCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "packId",
        "packVersion",
        "phase",
        "effect",
        "validator",
        "inputs",
        "outputSchemaId",
        "timeoutSeconds",
        "network",
        "filesystem",
        "envAllowlist",
        "resultConsumer",
        "dependsOn"
      ],
      "properties": {
        "checkId": {"$ref": "#/$defs/kebabId"},
        "packId": {"$ref": "#/$defs/kebabId"},
        "packVersion": {"$ref": "#/$defs/semver"},
        "phase": {"$ref": "#/$defs/phase"},
        "effect": {"enum": ["BLOCKING", "ADVISORY"]},
        "validator": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "builtinId"],
              "properties": {
                "kind": {"const": "BUILTIN"},
                "builtinId": {"$ref": "#/$defs/versionedId"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "argv"],
              "properties": {
                "kind": {"const": "TARGET_COMMAND"},
                "argv": {"$ref": "#/$defs/argv"}
              }
            }
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$", "maxLength": 128}
        },
        "outputSchemaId": {"$ref": "#/$defs/versionedId"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "network": {"const": "NONE"},
        "filesystem": {"const": "READ_ONLY"},
        "envAllowlist": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        },
        "resultConsumer": {"enum": ["DISPOSITION_REDUCER", "EVIDENCE_ONLY"]},
        "dependsOn": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/kebabId"}
        }
      }
    }
  }
}
