{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/kernel-pilot-qualification-policy.schema.json",
  "title": "kernel-pilot-qualification-policy@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "policyVersion", "frozenAt", "subject", "activationSpecificationDigest", "authorityId", "validityDays", "ceilings", "requiredChecks", "unresolvedIncidents"],
  "properties": {
    "schemaVersion": {"const": "kernel-pilot-qualification-policy@1"},
    "policyId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
    "policyVersion": {"type": "integer", "minimum": 1},
    "frozenAt": {"$ref": "#/$defs/time"},
    "subject": {"$ref": "#/$defs/subject"},
    "activationSpecificationDigest": {"$ref": "#/$defs/digest"},
    "authorityId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
    "validityDays": {"type": "integer", "minimum": 1, "maximum": 60},
    "ceilings": {
      "type": "object", "additionalProperties": false,
      "required": ["maxRuntimeSeconds", "maxArtifactBytes", "maxOutputBytes", "maxTasks"],
      "properties": {
        "maxRuntimeSeconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "maxArtifactBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maxTasks": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "requiredChecks": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["checkId", "platform", "profile", "argv", "expectedOutcome"],
        "properties": {
          "checkId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
          "platform": {"enum": ["darwin", "linux-oci"]},
          "profile": {"enum": ["STRICT", "STANDARD_TEST"]},
          "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
          "expectedOutcome": {"enum": ["PASS", "PROMOTABLE", "BLOCKED"]}
        }
      }
    },
    "unresolvedIncidents": {
      "type": "object", "additionalProperties": false,
      "required": ["critical", "high"],
      "properties": {"critical": {"const": 0}, "high": {"const": 0}}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["subjectId", "repository", "kernelRelease", "kernelCommit", "kernelTree"],
      "properties": {
        "subjectId": {"const": "shedu-promotion-kernel"},
        "repository": {"const": "https://github.com/Shedu-ai/shedu-promotion-kernel.git"},
        "kernelRelease": {"type": "string", "minLength": 1, "maxLength": 128},
        "kernelCommit": {"$ref": "#/$defs/sha40"},
        "kernelTree": {"$ref": "#/$defs/sha40"}
      }
    }
  }
}
