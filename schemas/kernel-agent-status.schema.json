{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/kernel-agent-status.schema.json",
  "title": "kernel-agent-status@1",
  "description": "Read-only projection of the kernel subject's branded admission and capability state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kernelRelease",
    "implementationStatus",
    "promotionEntrypointAvailable",
    "capabilities",
    "admissionReasonCodes",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": {"const": "kernel-agent-status@1"},
    "kernelRelease": {"type": "string", "minLength": 1, "maxLength": 128},
    "implementationStatus": {"enum": ["FOUNDATION_ONLY", "EXPERIMENTAL"]},
    "promotionEntrypointAvailable": {"type": "boolean"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$", "maxLength": 128}
    },
    "admissionReasonCodes": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64}
    },
    "nextActions": {"$ref": "#/$defs/nextActions"}
  },
  "$defs": {
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "OBTAIN_EXTERNAL_ADMISSION",
          "SUBMIT_EVALUATION",
          "RETURN_TO_AUTHORIZER",
          "REPAIR_CANDIDATE",
          "REPAIR_EVALUATION_ENVIRONMENT",
          "VERIFY_PROMOTABLE_RECEIPT",
          "EXTERNAL_PROMOTION_DECISION_AVAILABLE",
          "NONE"
        ]
      }
    }
  }
}
