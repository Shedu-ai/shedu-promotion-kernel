{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/kernel-pilot-qualification-input.schema.json",
  "title": "kernel-pilot-qualification-input@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subject", "policyDigest", "activationSpecificationDigest", "conformance", "results", "privateEvidenceManifest", "providerCalls"],
  "properties": {
    "schemaVersion": {"const": "kernel-pilot-qualification-input@1"},
    "subject": {"$ref": "#/$defs/subject"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "activationSpecificationDigest": {"$ref": "#/$defs/digest"},
    "conformance": {
      "type": "object", "additionalProperties": false,
      "required": ["attestationDigest", "certificationDigest", "mechanismInventoryDigest", "controlSurfaceDigest", "statusDigest"],
      "properties": {
        "attestationDigest": {"$ref": "#/$defs/digest"},
        "certificationDigest": {"$ref": "#/$defs/digest"},
        "mechanismInventoryDigest": {"$ref": "#/$defs/digest"},
        "controlSurfaceDigest": {"$ref": "#/$defs/digest"},
        "statusDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "results": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["checkId", "platform", "profile", "argv", "outcome", "exitCode", "evidenceDigest"],
        "properties": {
          "checkId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
          "platform": {"enum": ["darwin", "linux-oci"]},
          "profile": {"enum": ["STRICT", "STANDARD_TEST"]},
          "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
          "outcome": {"enum": ["PASS", "PROMOTABLE", "BLOCKED", "FAIL", "SKIPPED"]},
          "exitCode": {"type": "integer", "minimum": 0, "maximum": 255},
          "evidenceDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "privateEvidenceManifest": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifactId", "digest", "byteLength"],
        "properties": {
          "artifactId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
          "digest": {"$ref": "#/$defs/digest"},
          "byteLength": {"type": "integer", "minimum": 1, "maximum": 1073741824}
        }
      }
    },
    "providerCalls": {"const": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["subjectId", "repository", "kernelRelease", "kernelCommit", "kernelTree"],
      "properties": {
        "subjectId": {"const": "shedu-promotion-kernel"},
        "repository": {"const": "https://github.com/Shedu-ai/shedu-promotion-kernel.git"},
        "kernelRelease": {"type": "string", "minLength": 1, "maxLength": 128},
        "kernelCommit": {"$ref": "#/$defs/sha40"},
        "kernelTree": {"$ref": "#/$defs/sha40"}
      }
    }
  }
}
