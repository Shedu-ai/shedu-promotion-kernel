{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/promotion-kernel-activation-distribution-v2.schema.json",
  "title": "promotion-kernel-activation-distribution@2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "distributionId", "releaseTag", "requestedStatus", "kernel", "authority", "evidence", "commands"],
  "properties": {
    "schemaVersion": {"const": "promotion-kernel-activation-distribution@2"},
    "distributionId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
    "releaseTag": {"type": "string", "minLength": 1, "maxLength": 128},
    "requestedStatus": {"enum": ["PILOT_ELIGIBLE", "CERTIFIED"]},
    "kernel": {"type": "object", "additionalProperties": false, "required": ["repository", "release", "commit", "tree"], "properties": {
      "repository": {"const": "https://github.com/Shedu-ai/shedu-promotion-kernel.git"}, "release": {"type": "string", "minLength": 1, "maxLength": 128}, "commit": {"$ref": "#/$defs/sha40"}, "tree": {"$ref": "#/$defs/sha40"}
    }},
    "authority": {"type": "object", "additionalProperties": false, "required": ["authorityId", "algorithm", "publicKey", "path", "digest"], "properties": {
      "authorityId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128}, "algorithm": {"const": "ed25519"}, "publicKey": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128}, "digest": {"$ref": "#/$defs/digest"}
    }},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["conformanceAttestation", "conformanceCertification", "lifecycleAttestation", "lifecycleEvidence", "lifecyclePolicy", "activationSpecification"], "properties": {
      "conformanceAttestation": {"$ref": "#/$defs/member"}, "conformanceCertification": {"$ref": "#/$defs/member"}, "lifecycleAttestation": {"$ref": "#/$defs/member"}, "lifecycleEvidence": {"$ref": "#/$defs/member"}, "lifecyclePolicy": {"$ref": "#/$defs/member"}, "activationSpecification": {"$ref": "#/$defs/member"}
    }},
    "commands": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?::[a-z0-9]+)*(?:-[a-z0-9]+)*$", "maxLength": 128}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "member": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 128}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
