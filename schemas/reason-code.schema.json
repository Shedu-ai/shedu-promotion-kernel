{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/reason-code.schema.json",
  "title": "reason-code@1",
  "description": "Closed set of machine reason codes emitted by the promotion kernel. Adding a code requires a schema change; free-text reason codes are rejected.",
  "type": "string",
  "enum": [
