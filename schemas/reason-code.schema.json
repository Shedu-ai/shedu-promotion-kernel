    "DUPLICATE_JSON_KEY",
    "DOCUMENT_BOUNDS_EXCEEDED",
    "NON_CANONICAL_NUMBER",
    "SCHEMA_VIOLATION",
    "SECRET_BEARING_FIELD",
    "PATH_NOT_CONTAINED",
    "SCOPE_SET_CONFLICT",
    "DUPLICATE_COMMAND_ID",
    "DUPLICATE_CHECK_ID",
    "DUPLICATE_PACK_ID",
    "DUPLICATE_ENTRY_ID",
    "EVIDENCE_ONLY_BLOCKING_CONFLICT",
    "PHASE_NOT_DECLARED",
    "MOVING_REF_REJECTED",
    "AUTHORITY_OBJECT_MISSING",
    "AUTHORITY_PATH_NOT_BLOB",
    "AUTHORITY_DIGEST_MISMATCH",
    "PROFILE_IDENTITY_MISMATCH",
    "PACK_IDENTITY_MISMATCH",
    "PACK_NOT_FOUND",
    "PACK_NOT_SELECTED",
    "PACK_DIGEST_MISMATCH",
    "DEPENDENCY_UNSATISFIED",
    "DEPENDENCY_CYCLE",
    "PHASE_ORDER_CONFLICT",
    "UNKNOWN_VALIDATOR",
    "UNKNOWN_CHECK_STRENGTHENED",
    "STRENGTHEN_CONFLICT",
    "POLICY_CONFLICT",
    "PLAN_ORDER_VIOLATION",
    "ORPHAN_REGISTERED_NOT_IMPLEMENTED",
    "ORPHAN_IMPLEMENTED_NOT_REGISTERED",
    "ORPHAN_IMPLEMENTED_NOT_DISPATCHED",
    "ORPHAN_DISPATCHED_NOT_IMPLEMENTED",
    "ORPHAN_DISPATCHED_NOT_EMITTED",
    "ORPHAN_EMITTED_NOT_DISPATCHED",
    "ORPHAN_EMITTED_NOT_CONSUMED",
    "ORPHAN_CONSUMED_NOT_EMITTED",
    "INVALID_EXCLUSION",
    "KERNEL_NOT_IMPLEMENTED",
    "CLI_USAGE"
  ]
}
