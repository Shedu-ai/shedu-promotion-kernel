{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/check-result.schema.json",
  "title": "check-result@1",
  "description": "Typed result of one executed check, bound to the compiled plan and candidate identity. Console prose can never satisfy a check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkId",
    "packId",
    "planDigest",
    "candidateId",
    "effect",
    "outcome",
    "reasonCodes",
    "evidence",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "check-result@1"},
    "checkId": {"$ref": "#/$defs/kebabId"},
    "packId": {"$ref": "#/$defs/kebabId"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "candidateId": {"$ref": "#/$defs/commitId"},
    "effect": {"enum": ["BLOCKING", "ADVISORY"]},
    "outcome": {"enum": ["PASS", "FIRED", "INFRA_FAILURE", "SKIPPED"]},
    "reasonCodes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64}
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "digest"],
        "properties": {
          "artifactId": {"$ref": "#/$defs/kebabId"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "startedAt": {"$ref": "#/$defs/timestamp"},
    "completedAt": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "kebabId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 128},
    "commitId": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
