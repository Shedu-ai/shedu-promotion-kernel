{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Shedu-ai/shedu-promotion-kernel/main/schemas/conformance-status.schema.json",
  "title": "conformance-status@2",
  "description": "Portable semantic summary of the zero-provider conformance matrix. Host-bound command reports, evidence, receipts, and evaluation digests remain retained outside this projection; every projected field is reproducible across supported attestation hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kernelRelease", "allPassed", "cases", "kernelActivation", "controlCensus"],
  "properties": {
    "schemaVersion": {"const": "conformance-status@2"},
    "kernelRelease": {"type": "string", "minLength": 1, "maxLength": 128},
    "allPassed": {"type": "boolean"},
    "controlCensus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "registered", "proven", "productionRequired", "productionObserved", "productionEvidenceDigest", "findings"],
      "properties": {
        "complete": {"type": "boolean"},
        "registered": {"type": "integer", "minimum": 0},
        "proven": {"type": "integer", "minimum": 0},
        "productionRequired": {"type": "integer", "minimum": 1},
        "productionObserved": {"type": "integer", "minimum": 0},
        "productionEvidenceDigest": {"$ref": "#/$defs/digest"},
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reasonCode"],
            "properties": {
              "id": {"$ref": "#/$defs/kebabId"},
              "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64}
            }
          }
        }
      }
    },
    "kernelActivation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mechanismId", "caseId", "proven"],
        "properties": {
          "mechanismId": {"$ref": "#/$defs/kebabId"},
          "caseId": {"$ref": "#/$defs/kebabId"},
          "proven": {"type": "boolean"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "conforming", "planted"],
        "properties": {
          "caseId": {"$ref": "#/$defs/kebabId"},
          "conforming": {"$ref": "#/$defs/runSummary"},
          "planted": {"$ref": "#/$defs/runSummary"}
        }
      }
    }
  },
  "$defs": {
    "kebabId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 128},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "planDigest", "resultProjectionDigest", "receiptVerified"],
      "properties": {
        "disposition": {"enum": ["PROMOTABLE", "BLOCKED"]},
        "planDigest": {"$ref": "#/$defs/digest"},
        "resultProjectionDigest": {"$ref": "#/$defs/digest"},
        "receiptVerified": {"type": "boolean"}
      }
    }
  }
}
